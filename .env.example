# AG2R Configuration
# Copy this file to .env and edit as needed.
# See README.md for setup instructions.

# ─── Server ───────────────────────────────────
PORT=3000

# ─── Remote Access ────────────────────────────
# Set TUNNEL_URL to your public URL when behind a reverse proxy (nginx,
# Cloudflare tunnel, etc.). This:
#   - Switches AG2R to HTTP-only (the proxy handles TLS termination)
#   - Makes push notification links point to the correct public URL
#   - Enables trust proxy (reads real client IP from X-Forwarded-*)
#
# AUTH_ENABLED=true
# APP_PASSWORD=your-strong-password-here
# SESSION_SECRET=<run: openssl rand -hex 32>
# TUNNEL_URL=https://your-domain.com
